{
  "display_information": {
    "name": "SlackOC",
    "description": "Control an OpenCode agent on your own machine from Slack. Prompts stream into threads; approvals live here too.",
    "background_color": "#4c1d95"
  },
  "features": {
    "bot_user": {
      "display_name": "SlackOC",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.im"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
