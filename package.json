{
  "name": "slackoc",
  "version": "0.3.0",
  "description": "Control a local OpenCode session from Slack. No terminal, SSH, or VPN.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "slackoc": "dist/cli.js"
  },
  "files": [
    "dist",
    "manifest",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --dir test",
    "smoke": "tsx test/integration/smoke.ts",
    "check": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/client": "^2.0.12",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "8.1.1",
    "cron-parser": "^5.10.1",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.12",
    "@types/node": "^24",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
